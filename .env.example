# Chintu AI Configuration Template
# Rename this file to .env and fill in your values

# --- LLM API Keys (Optional if using Ollama) ---
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=your_google_ai_key_here

# --- System Configuration ---
# Sensitivity for "Hey Chintu" wake word (0.0 to 1.0)
WAKE_WORD_SENSITIVITY=0.85

# How long to wait for user input before sleeping (seconds)
CONVERSATION_TIMEOUT_SECONDS=15.0

# Enable/Disable Text-to-Speech automatically
TTS_AUTO_SPEAK=False

# --- Customization ---
USER_NAME=User
ASSISTANT_NAME=Chintu

# --- Skills ---
CHINTU_SKILLS_ENABLED=false
CHINTU_SKILLS_ALLOW_SHELL=false
CHINTU_SKILLS_USE_DOCKER=false
CHINTU_SKILLS_DOCKER_IMAGE=python:3.11-slim
CHINTU_SKILLS_DOCKER_NETWORK_MODE=none
CHINTU_SKILLS_DOCKER_WORKDIR=/app

# Optional skill credentials (only if you use these skills)
GITHUB_TOKEN=
NOTION_TOKEN=
HASS_URL=
HASS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram ---
CHINTU_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- WhatsApp (Twilio) ---
CHINTU_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
CHINTU_WHATSAPP_ALLOWED_NUMBERS=
