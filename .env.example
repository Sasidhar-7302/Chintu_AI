# Chintu AI (.env template)
#
# Notes:
# - Most settings use the CHINTU_ prefix.
# - API keys can be stored either here OR (recommended) in the Identity Vault via UI/CLI.
# - Never commit real secrets.

# --- General ---
CHINTU_DEBUG=false
CHINTU_LOG_LEVEL=INFO
CHINTU_USER_NAME=User
CHINTU_ASSISTANT_NAME=Chintu

# --- Local brain (Ollama) ---
CHINTU_OLLAMA_HOST=http://localhost:11434
CHINTU_OLLAMA_KEEP_ALIVE_SECONDS=600
CHINTU_OLLAMA_THINK=false
CHINTU_OLLAMA_THINK_FOR_COMPLEX_REASONING=true
CHINTU_OLLAMA_RETRY_AFTER_SECONDS=8
CHINTU_OLLAMA_MODEL=qwen3.5:4b
CHINTU_OLLAMA_MODEL_STRONG=qwen3.5:9b
CHINTU_LLM_NUM_GPU=-1
CHINTU_LLM_PREWARM_ENABLED=true
CHINTU_LLM_PREWARM_INCLUDE_STRONG=true
# Optional large-local text backend (AirLLM, text-only)
CHINTU_AIRLLM_ENABLED=false
CHINTU_AIRLLM_MODEL_ID=
# Optional: set to a drive/folder with high free space for AirLLM layer shards.
CHINTU_AIRLLM_CACHE_DIR=
CHINTU_AIRLLM_MAX_TOKENS=2048
# auto chooses safer defaults by OS (Windows -> no compression to avoid bnb crashes).
CHINTU_AIRLLM_COMPRESSION=auto
# auto chooses safer defaults by OS (Windows -> cpu to avoid CUDA crashes).
CHINTU_AIRLLM_DEVICE=auto
# If false, AirLLM will fail fast when model shards are missing (no hidden long downloads).
CHINTU_AIRLLM_ALLOW_DOWNLOAD=false
CHINTU_AIRLLM_DOWNLOAD_TIMEOUT_SECONDS=3600
# auto: subprocess on Windows for crash isolation, inprocess on Linux/macOS.
CHINTU_AIRLLM_RUNTIME_MODE=auto
# Max seconds to wait for a single AirLLM response before fallback.
CHINTU_AIRLLM_REQUEST_TIMEOUT_SECONDS=900
# Max seconds to wait for worker boot + first ping.
CHINTU_AIRLLM_STARTUP_TIMEOUT_SECONDS=1800
CHINTU_VISION_PREWARM_ENABLED=false
# Local vision model (UI/OCR/agent tasks)
CHINTU_VISION_OLLAMA_MODEL=llava:7b
# Prefer local vision (Ollama) over cloud vision backends when both are configured.
CHINTU_VISION_PREFER_LOCAL=true

# --- Cloud LLM routing (optional) ---
# Groq
GROQ_API_KEY=
# Google Gemini
GOOGLE_AI_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# NVIDIA (NIM / integrate.api.nvidia.com)
NVIDIA_API_KEY=

# --- Browser fallback (optional) ---
CHINTU_BROWSER_FALLBACK_ENABLED=false
CHINTU_BROWSER_CDP_URL=http://localhost:9222
CHINTU_BROWSER_FALLBACK_URL=https://chatgpt.com
# Optional: point to native Chrome user-data root to reuse an existing Chrome profile.
# Example (Windows): C:\Users\<you>\AppData\Local\Google\Chrome\User Data
CHINTU_BROWSER_PROFILES_DIR=
# Persistent browser profiles used by Playwright (stored under ~/.chintu/browser_profiles by default)
CHINTU_RESEARCH_BROWSER_DEFAULT_PROFILE=research
CHINTU_RESEARCH_BROWSER_LOGGEDIN_PROFILE=assistant_accounts
# Keep true for safe publish gating (social/research submit requires explicit confirmation)
CHINTU_RESEARCH_BROWSER_SUBMIT_REQUIRES_CONFIRMATION=true
# Hard block checkout/payment actions in browser flows (recommended: true)
CHINTU_SECURITY_PAYMENT_HARD_BLOCK=true

# --- Telegram bot channel (optional) ---
CHINTU_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Keep 0 to auto-bind first Telegram user who messages the bot.
TELEGRAM_ALLOWED_USER_ID=0
# pairing | open
CHINTU_TELEGRAM_DM_POLICY=pairing

# --- Email triage (optional, IMAP read-only) ---
CHINTU_EMAIL_IMAP_HOST=
CHINTU_EMAIL_IMAP_PORT=993
CHINTU_EMAIL_IMAP_USER=
# Recommended: store this in Identity Vault as service=email username=imap_password
CHINTU_EMAIL_IMAP_PASSWORD=
CHINTU_EMAIL_IMAP_FOLDER=INBOX

# --- Jira integration (optional, ticket automation) ---
CHINTU_JIRA_BASE_URL=
CHINTU_JIRA_EMAIL=
CHINTU_JIRA_PROJECT_KEY=
CHINTU_JIRA_ISSUE_TYPE=Task
# Recommended: store this in Identity Vault as service=jira username=api_token
CHINTU_JIRA_API_TOKEN=
